# formsam — Mailserver Stalwart als systemd-Dienst (nur Produktivserver). Liegt unter /etc/systemd/system/stalwart.service
# Grundlage: Dienst-Datei aus dem offiziellen install.sh von Stalwart, ergänzt um dieselbe Härtung wie formsam.service.
[Unit]
Description=Stalwart Mailserver (formsam)
Conflicts=postfix.service sendmail.service exim4.service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
LimitNOFILE=65536
KillMode=process
KillSignal=SIGINT
Restart=on-failure
RestartSec=5
# Hostname, öffentliche URL (nginx macht HTTPS davor); in der Ersteinrichtung auch Recovery-Modus/-Admin
EnvironmentFile=-/etc/stalwart/stalwart.env
ExecStart=/usr/local/bin/stalwart --config=/etc/stalwart/config.json
SyslogIdentifier=stalwart
User=stalwart
Group=stalwart
# Ports unter 1024 (25, 465, 587, 993) ohne root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Härtung: nur Daten, Logs und Konfiguration beschreibbar
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stalwart /var/log/stalwart /etc/stalwart
PrivateTmp=true

[Install]
WantedBy=multi-user.target
